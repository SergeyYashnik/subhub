ENV=local

# Database Settings
DB_USER=postgres
DB_PASSWORD=postgres_pass
DB_NAME=subscriptions_db
DB_HOST=db
DB_PORT=5432
DB_EXTERNAL_PORT=5436

# App Settings
APP_PORT=8080
APP_EXTERNAL_PORT=8080

# DSN для подключения (и для sqlx, и для миграций)
DB_DSN=postgres://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?sslmode=disable